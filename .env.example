# Environment variables read by S.A.F.E.R. Copy to .env (gitignored) or export
# them in your shell. None are needed for `make test` or `make mock`.

# Admin portal (Portal/app.py)
PPE_API_KEY=change-me                 # shared key the robot sends in X-API-Key; must match the robot's portal.api_key
PPE_ADMIN_PASSWORD=                   # password for browsing the portal; empty = no login (trusted LAN only)
PPE_ROBOT_MJPEG=http://192.168.1.60:8080/stream.mjpg   # robot's live stream, proxied at /live

# Robot (Code/Server/ppe_main.py)
PPE_CONFIG=                           # optional path to an alternate ppe_config.json
# The robot's portal.api_key may be set to "env:PPE_TOKEN" to read the key from PPE_TOKEN
PPE_TOKEN=change-me
